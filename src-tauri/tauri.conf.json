{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoTek Manager",
  "mainBinaryName": "gotek-manager",
  "version": "0.1.0",
  "identifier": "uk.co.gotekmanager.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GoTek Manager",
        "width": 1220,
        "height": 780,
        "minWidth": 850,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Organise and provision GoTek media",
    "longDescription": "A cross-platform desktop application for cataloguing retro software images and safely preparing GoTek USB media, folders, and image files.",
    "homepage": "https://github.com/peteclarke-del/GoTekManager",
    "license": "MIT",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libsoup-3.0-0"
        ],
        "section": "utils",
        "priority": "optional"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libsoup3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
