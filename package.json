{
  "name": "gotek-manager",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "esbuild scripts/checks.ts --bundle --platform=node --format=cjs --jsx=automatic --loader:.css=empty --define:import.meta.env='{\"DEV\":false}' --outfile=node_modules/.cache/gotek-checks.cjs --log-level=warning && node node_modules/.cache/gotek-checks.cjs",
    "check:native": "sh -lc '. \"$HOME/.cargo/env\" && cd src-tauri && cargo test'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:format": "prettier --check . && sh -lc '. \"$HOME/.cargo/env\" && cd src-tauri && cargo fmt --check'",
    "verify": "npm run build && npm run lint && npm run check:format && npm run check && npm run check:native",
    "screenshots": "bash scripts/capture-screenshots.sh light && bash scripts/capture-screenshots.sh dark",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "package:linux": "sh -lc '. \"$HOME/.cargo/env\" && tauri build --bundles deb,rpm,appimage'",
    "package:deb": "sh -lc '. \"$HOME/.cargo/env\" && tauri build --bundles deb'",
    "package:rpm": "sh -lc '. \"$HOME/.cargo/env\" && tauri build --bundles rpm'",
    "package:appimage": "sh -lc '. \"$HOME/.cargo/env\" && tauri build --bundles appimage'",
    "package:windows": "tauri build --bundles msi,nsis",
    "package:macos": "tauri build --bundles app,dmg"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.5"
  }
}
